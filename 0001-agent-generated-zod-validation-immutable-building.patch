+import { describe, expect, it } from 'vitest';
+import { Building } from '../src/entities/Building.js';
+import { Room } from '../src/entities/Room.js';
+import { Wall } from '../src/entities/Wall.js';
+import { Door } from '../src/entities/Door.js';
+import { Coordinate } from '../src/value-objects/Coordinate.js';
+import { Area } from '../src/value-objects/Area.js';
+import { Length } from '../src/value-objects/Length.js';
+
+function makeRoom() {
+  return new Room({
+    name: 'Office',
+    number: '1',
+    area: Area.fromSquareMeters(12),
+    level: 'Ground',
+    boundaries: [Coordinate.create(0, 0), Coordinate.create(4, 0), Coordinate.create(4, 3)]
+  });
+}
+
+function makeWall() {
+  return new Wall({
+    start: Coordinate.create(0, 0),
+    end: Coordinate.create(4, 0),
+    height: Length.fromMeters(2.7),
+    thickness: Length.fromMeters(0.115),
+    material: 'brick',
+    wallType: 'exterior'
+  });
+}
+
+describe('Building immutability', () => {
+  it('addRoom returns a new Building and leaves the original untouched', () => {
+    const original = new Building({});
+    const room = makeRoom();
+
+    const updated = original.addRoom(room);
+
+    expect(original.rooms).toHaveLength(0);
+    expect(updated.rooms).toHaveLength(1);
+    expect(updated).not.toBe(original);
+    expect(updated.version).toBe(original.version + 1);
+  });
+
+  it('addWall returns a new Building and leaves the original untouched', () => {
+    const original = new Building({});
+    const wall = makeWall();
+
+    const updated = original.addWall(wall);
+
+    expect(original.walls).toHaveLength(0);
+    expect(updated.walls).toHaveLength(1);
+  });
+
+  it('addDoor rejects a host wall not present in the building', () => {
+    const wall = makeWall();
+    const door = new Door({
+      hostWall: wall,
+      position: Coordinate.create(2, 0),
+      width: Length.fromMeters(0.9),
+      height: Length.fromMeters(2.1),
+      swing: 'left',
+      type: 'single'
+    });
+
+    const buildingWithoutWall = new Building({});
+    const buildingWithWall = buildingWithoutWall.addWall(wall);
+
+    expect(() => buildingWithoutWall.addDoor(door)).toThrow();
+    expect(buildingWithWall.addDoor(door).doors).toHaveLength(1);
+  });
+});
