+import { describe, expect, it } from 'vitest';
+import { Wall } from '../src/entities/Wall.js';
+import { Project } from '../src/entities/Project.js';
+import { ProjectValidator } from '../src/validators/ProjectValidator.js';
+
+describe('Zod boundary validation', () => {
+  it('Wall.fromJSON round-trips valid JSON', () => {
+    const json = {
+      id: 'wall-1',
+      start: { x: 0, y: 0 },
+      end: { x: 4, y: 0 },
+      height: 2.7,
+      thickness: 0.115,
+      material: 'brick',
+      wallType: 'exterior'
+    };
+
+    const parsed = Wall.fromJSON(json);
+    expect(parsed.material).toBe('brick');
+    expect(parsed.height.meters).toBe(2.7);
+  });
+
+  it('Wall.fromJSON rejects malformed JSON with a clear error', () => {
+    expect(() =>
+      Wall.fromJSON({
+        id: 'wall-2',
+        start: { x: 0, y: 0 },
+        end: { x: 4, y: 0 },
+        height: -1, // invalid: must be positive
+        thickness: 0.115,
+        material: 'brick',
+        wallType: 'exterior'
+      })
+    ).toThrow(/Invalid Wall JSON/);
+  });
+
+  it('Wall.fromJSON rejects an unknown wallType', () => {
+    expect(() =>
+      Wall.fromJSON({
+        id: 'wall-3',
+        start: { x: 0, y: 0 },
+        end: { x: 4, y: 0 },
+        height: 2.7,
+        thickness: 0.115,
+        material: 'brick',
+        wallType: 'load-bearing'
+      })
+    ).toThrow(/Invalid Wall JSON/);
+  });
+});
+
+describe('ProjectValidator', () => {
+  it('validates a well-formed Project', () => {
+    const project = Project.create({
+      name: 'Riverside Clinic',
+      client: 'City Health Dept',
+      site: 'Riverside',
+      revision: 'A'
+    });
+
+    expect(ProjectValidator.validate(project)).toEqual({ valid: true });
+  });
+
+  it('validateJson reports shape errors without constructing a Project', () => {
+    const result = ProjectValidator.validateJson({ name: 'Missing fields' });
+    expect(result.valid).toBe(false);
+    if (!result.valid) {
+      expect(result.errors.length).toBeGreaterThan(0);
+    }
+  });
+});
