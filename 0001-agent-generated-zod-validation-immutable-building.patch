+/**
+ * AUTO-GENERATED FILE
+ * Generated by: Claude (spds-ai-architect skill)
+ * Generated at: 2026-08-10T08:25:21Z
+ * Base prompt: draft these three as a fix on a feature branch (`agent/...`, tagged
+ * Reviewer: (pending human review)
+ * Status: DRAFT
+ */
+
+import { z } from 'zod';
+
+/**
+ * Validates raw JSON before it reaches an entity's `fromJSON` factory.
+ *
+ * Per ADR 0001, external input is validated via Zod schemas at the boundary; domain
+ * constructors/factories then enforce their own invariants internally. These schemas
+ * intentionally stay permissive on shape (e.g. `z.record` for nested objects) and defer
+ * deep construction to the value objects and entities themselves — Zod's job here is to
+ * reject malformed/missing fields early with a clear error, not to duplicate domain logic.
+ */
+
+export const coordinateJsonSchema = z.object({
+  x: z.number().finite(),
+  y: z.number().finite()
+});
+
+export const identifierJsonSchema = z.string().min(1);
+
+const auditFieldsSchema = {
+  id: identifierJsonSchema,
+  createdAt: z.union([z.string(), z.date()]).optional(),
+  updatedAt: z.union([z.string(), z.date()]).optional(),
+  version: z.number().int().positive().optional()
+};
+
+export const wallJsonSchema = z.object({
+  ...auditFieldsSchema,
+  start: coordinateJsonSchema,
+  end: coordinateJsonSchema,
+  height: z.number().positive(),
+  thickness: z.number().positive(),
+  material: z.string().min(1),
+  wallType: z.enum(['exterior', 'interior', 'party'])
+});
+
+export const doorJsonSchema = z.object({
+  ...auditFieldsSchema,
+  hostWall: wallJsonSchema,
+  position: coordinateJsonSchema,
+  width: z.number().positive(),
+  height: z.number().positive(),
+  swing: z.enum(['left', 'right', 'inward', 'outward']),
+  type: z.enum(['single', 'double', 'sliding', 'pivot'])
+});
+
+export const windowJsonSchema = z.object({
+  ...auditFieldsSchema,
+  hostWall: wallJsonSchema,
+  position: coordinateJsonSchema,
+  width: z.number().positive(),
+  height: z.number().positive(),
+  sillHeight: z.number().nonnegative()
+});
+
+export const roomJsonSchema = z.object({
+  ...auditFieldsSchema,
+  name: z.string().min(1),
+  number: z.string().min(1),
+  area: z.number().positive(),
+  level: z.string().min(1),
+  boundaries: z.array(coordinateJsonSchema).min(3),
+  finish: z.string().optional()
+});
+
+export const buildingJsonSchema = z.object({
+  ...auditFieldsSchema,
+  levels: z.array(z.string()).optional(),
+  rooms: z.array(roomJsonSchema).optional(),
+  walls: z.array(wallJsonSchema).optional(),
+  doors: z.array(doorJsonSchema).optional(),
+  windows: z.array(windowJsonSchema).optional(),
+  roofs: z.array(z.string()).optional(),
+  floors: z.array(z.string()).optional(),
+  ceilings: z.array(z.string()).optional()
+});
+
+export const projectJsonSchema = z.object({
+  ...auditFieldsSchema,
+  name: z.string().min(1),
+  client: z.string().min(1),
+  site: z.string().min(1),
+  building: buildingJsonSchema.optional(),
+  revision: z.string().min(1),
+  metadata: z.record(z.string(), z.union([z.string(), z.number(), z.boolean()])).optional()
+});
+
+/**
+ * Parses and validates raw JSON against a schema, throwing a domain-friendly error on
+ * failure instead of leaking a raw ZodError past the boundary.
+ */
+export function parseDomainJson<T>(schema: z.ZodType<T>, json: unknown, entityName: string): T {
+  const result = schema.safeParse(json);
+  if (!result.success) {
+    const issues = result.error.issues.map((issue) => `${issue.path.join('.') || '(root)'}: ${issue.message}`).join('; ');
+    throw new Error(`Invalid ${entityName} JSON: ${issues}`);
+  }
+  return result.data;
+}
