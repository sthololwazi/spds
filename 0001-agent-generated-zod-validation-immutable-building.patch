+   * `Project` (and therefore without throwing on the first invariant violation). Useful
+   * for surfacing all shape errors at once, e.g. in an API request handler.
+   */
+  static validateJson(json: unknown): ProjectValidationResult {
+    const result = projectJsonSchema.safeParse(json);
+    if (result.success) {
+      return { valid: true };
+    }
+    const errors = result.error.issues.map(
+      (issue: z.ZodIssue) => `${issue.path.join('.') || '(root)'}: ${issue.message}`
+    );
+    return { valid: false, errors };
   }
 }
